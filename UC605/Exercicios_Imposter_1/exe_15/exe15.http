### 1.
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "port": 4561,
  "protocol": "http",
  "name": "Exercício 15 - GET Fallback",
  "stubs": [
    {
      "predicates": [
        {
          "equals": {
            "method": "GET",
            "path": "/test/success"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "status": "ok",
              "message": "Caminho específico encontrado."
            }
          }
        }
      ]
    },
    {
      "predicates": [
        {
          "equals": {
            "method": "GET"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 404,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "error": "not_found",
              "message": "O recurso GET que tentou aceder não foi encontrado."
            }
          }
        }
      ]
    }
  ]
}


