### 1.
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "port": 4566,
  "protocol": "http",
  "name": "API Gestão de Funcionários",
  "stubs": [
    {
      "predicates": [
        { "equals": { "method": "POST", "path": "/api/funcionarios" } },
        { 
          "matches": { "body": "\"salario\"\\s*:\\s*500" } 
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "validation_error", "message": "O salário não pode ser inferior ao mínimo (760 €)." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "PUT", "path": "/api/funcionarios/101/salario" } },
        { 
          "matches": { "body": "\"salario\"\\s*:\\s*500" } 
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "validation_error", "message": "O salário não pode ser inferior ao mínimo (760 €)." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "PUT", "path": "/api/funcionarios/101/salario" } },
        { "contains": { "body": "\"salario\":500" } }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "validation_error", "message": "O salário não pode ser inferior ao mínimo (760 €)." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "DELETE", "path": "/api/funcionarios/101" } }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 409,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "conflict", "message": "Não é possível remover o funcionário 101 (tem tarefas pendentes)." }
          }
        }
      ]
    },


    {
      "predicates": [ { "equals": { "method": "PUT", "path": "/api/funcionarios/101/salario" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": { "status": "ok", "message": "Salário do funcionário 101 atualizado." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "POST", "path": "/api/funcionarios" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 201,
            "headers": { "Content-Type": "application/json", "Location": "/api/funcionarios/103" },
            "body": { "id": 103, "status": "created", "message": "Funcionário adicionado com sucesso." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "DELETE", "path": "/api/funcionarios/102" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": { "status": "removido", "message": "Funcionário 102 removido." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/funcionarios" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": [ { "id": 101, "nome": "Ana" }, { "id": 102, "nome": "Bruno" } ]
          }
        }
      ]
    }
  ]
}


