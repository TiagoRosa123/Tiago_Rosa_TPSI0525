### 1.
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "port": 4562,
  "protocol": "http",
  "name": "API Gestão de Alunos",
  "stubs": [

    {
      "predicates": [
        { "equals": { "method": "POST", "path": "/api/alunos" } },
        { 
          "matches": { "body": "\"idade\":\\s*[1-9]" } 
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "validation_error", "message": "Idade mínima (10) não atingida." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "POST", "path": "/api/alunos" } },
        { "contains": { "body": "\"curso\":\"Inexistente\"" } }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 404,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "not_found", "message": "Curso não encontrado." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "DELETE", "path": "/api/alunos/101" } }, 
        { "not": { "equals": { "headers": { "X-Admin": "true" } } } }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 403,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "forbidden", "message": "Permissão de administração necessária para DELETE." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/alunos/101" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": { "id": 101, "nome": "João Silva", "idade": 21, "curso": "Engenharia" }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "PUT", "path": "/api/alunos/101" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": { "status": "ok", "message": "Aluno 101 atualizado." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "POST", "path": "/api/alunos" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 201,
            "headers": { "Content-Type": "application/json", "Location": "/api/alunos/999" },
            "body": { "id": 999, "status": "created", "message": "Aluno adicionado com sucesso." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/alunos" } } ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": [ { "id": 101, "nome": "João" }, { "id": 102, "nome": "Ana" } ]
          }
        }
      ]
    }
  ]
}


