### 1.
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "port": 4567,
  "protocol": "http",
  "name": "API Gestão de Tarefas",
  "stubs": [
    {
      "predicates": [
        { "equals": { "method": "POST", "path": "/api/tarefas" } },
        { 
          "matches": { "body": "\"titulo\"\\s*:\\s*\"\"" } 
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "validation_error", "message": "O campo 'titulo' não pode ser vazio." }
          }
        }
      ]
    },
    {
      "predicates": [
        { "equals": { "method": "DELETE", "path": "/api/tarefas/101" } }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 409,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "conflict", "message": "A tarefa 101 está pendente e não pode ser removida." }
          }
        }
      ]
    },

    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/tarefas/101" } } ],
      "responses": [
        {
          "is": { "statusCode": 200, "headers": { "Content-Type": "application/json" },
            "body": { "id": 101, "titulo": "Resolver Bug", "estado": "pendente" }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/tarefas/102" } } ],
      "responses": [
        {
          "is": { "statusCode": 200, "headers": { "Content-Type": "application/json" },
            "body": { "id": 102, "titulo": "Fazer Deploy", "estado": "concluída" }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "PUT", "path": "/api/tarefas/101" } } ],
      "responses": [
        {
          "is": { "statusCode": 200, "headers": { "Content-Type": "application/json" },
            "body": { "id": 101, "status": "atualizado", "novo_estado": "concluída" }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "DELETE", "path": "/api/tarefas/102" } } ],
      "responses": [
        {
          "is": { "statusCode": 200, "headers": { "Content-Type": "application/json" },
            "body": { "status": "removido", "message": "Tarefa 102 removida." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "POST", "path": "/api/tarefas" } } ],
      "responses": [
        {
          "is": { "statusCode": 201, "headers": { "Content-Type": "application/json", "Location": "/api/tarefas/103" },
            "body": { "id": 103, "status": "created", "message": "Tarefa criada com sucesso." }
          }
        }
      ]
    },
    {
      "predicates": [ { "equals": { "method": "GET", "path": "/api/tarefas" } } ],
      "responses": [
        {
          "is": { "statusCode": 200, "headers": { "Content-Type": "application/json" },
            "body": [ { "id": 101, "titulo": "Resolver Bug" }, { "id": 102, "titulo": "Fazer Deploy" } ]
          }
        }
      ]
    }
  ]
}


